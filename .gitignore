# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# macOS
.DS_Store

# DICOM files are ignored by default so that real patient data cannot be committed
# by accident. The sample/ set is synthetic and deliberately tracked.
*.dcm
!sample/**/*.dcm

# Likewise for the filename mapping: on real data this file is the re-identification
# key and must never enter version control. sample/'s maps synthetic names only.
filename_mappings.csv
!sample/filename_mappings.csv

# compile_metadata.py's default output. Run against a non-anonymized folder it is a
# spreadsheet of that folder's PHI, so it is ignored by default like the DICOMs are.
dicom_metadata.csv

# Scratch output from running pipeline.py against the sample data. It duplicates the
# committed sample/anonymized_* folders, so there is no reason to track a second copy.
sample/pipeline_output/

# Partial files left behind by an interrupted rename
*.dcm.partial
